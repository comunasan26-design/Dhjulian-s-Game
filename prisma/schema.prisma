// Esquema do banco de dados (SQLite via Prisma 7 + @prisma/adapter-better-sqlite3).
// O banco é um arquivo na própria pasta prisma/ (prisma/jogo.db), criado sozinho na primeira inicialização.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  /** Último sinal de vida (para contar quem está online). */
  lastSeenAt   DateTime     @default(now())
  /** Rating do modo ranqueado (estilo Elo; começa em 1200 e é exibido arredondado). */
  rating       Float        @default(1200)
  rankedGames  Int          @default(0)
  sessions     Session[]
  rooms        RoomPlayer[]
  hostedRooms  Room[]       @relation("RoomHost")
  queue        RankedQueue?
  rankedResults RankedResult[]

  @@index([rating])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

enum RoomStatus {
  LOBBY
  PLAYING
  FINISHED
}

model Room {
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  hostId     String
  host       User         @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  status     RoomStatus   @default(LOBBY)
  maxPlayers Int          @default(6)
  // Quantidade de bots (controlados pelo servidor) na sala
  bots       Int          @default(0)
  // Dificuldade dos bots (1 a 30)
  botSkill   Int          @default(20)
  // Partida do modo ranqueado (criada pela fila; não aparece na lista de salas)
  ranked     Boolean      @default(false)
  version    Int          @default(0)
  // Estado completo do jogo (JSON). Só é enviado aos clientes depois de filtrado por jogador.
  state      Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  players    RoomPlayer[]

  @@index([status, updatedAt])
}

model RoomPlayer {
  roomId     String
  userId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat       Int
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@id([roomId, userId])
  @@index([userId])
}

/// Fila do modo ranqueado: quem está procurando partida.
model RankedQueue {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Float
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /** Código da sala quando a partida foi formada. */
  roomCode   String?
}

/// Uma partida ranqueada: jogadores e ratings de antes, e o resultado (também o log humano x bot).
model RankedMatch {
  id         String         @id @default(cuid())
  roomCode   String         @unique
  /** Conta para o rating? (não conta com 4 ou mais bots) */
  counted    Boolean
  botSkill   Int
  /** [{ id, name, bot, rating, games, skill? }] no início da partida */
  players    Json
  /** Colocações, variações e duelos humano x bot (para recalibrar os bots) */
  results    Json?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?
  entries    RankedResult[]
}

/// Resultado de um humano numa partida ranqueada (histórico de rating).
model RankedResult {
  id           String      @id @default(cuid())
  matchId      String
  match        RankedMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  position     Int
  ratingBefore Float
  ratingAfter  Float
  delta        Float
  abandoned    Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
}
