# URL do PostgreSQL usada pela aplicação (na Vercel, use a URL com pooler se o provedor oferecer)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"
# Opcional: URL direta (sem pooler) usada apenas pelo Prisma CLI para rodar migrações
# DIRECT_URL="postgresql://usuario:senha@host-direto:5432/banco?schema=public"
# Opcional: "false" deixa o login funcionar acessando por http://IP:porta (sem HTTPS). Use só para testes.
# COOKIE_SECURE="false"
